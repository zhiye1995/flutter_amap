<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          高德内置路线规划/导航页面的承载 Activity（用于系统栏/安全区处理）。
          通过 AmapNaviPage.showRouteActivity(..., customActivityClass) 启动。
        -->
        <activity
                android:name="com.morbit.amap_flutter_navi.AMapFlutterRouteActivity"
                android:configChanges="orientation|keyboardHidden|screenSize|navigation"
                android:theme="@style/AMapFlutterRouteTheme"/>
    </application>
</manifest>
    
